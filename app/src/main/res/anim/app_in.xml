<?xml version="1.0" encoding="utf-8"?>
<!-- App appears over its coloured splash: quick fade with a slight settle. -->
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:interpolator="@android:interpolator/decelerate_cubic" android:zAdjustment="top">
    <alpha android:fromAlpha="0" android:toAlpha="1" android:duration="220" />
    <scale android:fromXScale="1.04" android:toXScale="1" android:fromYScale="1.04" android:toYScale="1"
        android:pivotX="50%" android:pivotY="50%" android:duration="260" />
</set>
