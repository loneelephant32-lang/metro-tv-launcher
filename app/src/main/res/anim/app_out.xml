<?xml version="1.0" encoding="utf-8"?>
<!-- Windows 8 close: the app shrinks towards the centre and fades out. -->
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:interpolator="@android:interpolator/accelerate_cubic" android:zAdjustment="top">
    <scale android:fromXScale="1" android:toXScale="0.55" android:fromYScale="1" android:toYScale="0.55"
        android:pivotX="50%" android:pivotY="50%" android:duration="260" />
    <alpha android:fromAlpha="1" android:toAlpha="0" android:startOffset="60" android:duration="200" />
</set>
